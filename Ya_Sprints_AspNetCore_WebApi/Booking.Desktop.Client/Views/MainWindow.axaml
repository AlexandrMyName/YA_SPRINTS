<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        xmlns:vm="clr-namespace:Sprints.Desktop.ViewModels"
        xmlns:views="clr-namespace:Booking.Desktop.Client"
        Width="1280" Height="780"
        MinWidth="900" MinHeight="600"
        Background="#ECEFF1"
        x:Class="Booking.Desktop.Client.MainWindow"
        Title="Booking.Desktop.Client">

       <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
          <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShellViewModel}">
          <views:ShellView />
        </DataTemplate>
      </Window.DataTemplates>

  <ContentControl Content="{Binding CurrentView}" />
</Window>