<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Booking.Desktop.Client.EventWindow"
          Width="440" Height="440"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#ECEFF1"
        Title="Событие">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Создать событие"
               FontSize="16" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,12"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="Название" Classes="section"/>
          <TextBox x:Name="TitleBox" Watermark="Встреча команды"/>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Описание" Classes="section"/>
          <TextBox x:Name="DescBox" AcceptsReturn="True" Height="60"
                   TextWrapping="Wrap" Watermark="Обсуждение спринта"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,*">
          <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
            <TextBlock Text="Начало (UTC)" Classes="section"/>
            <TextBox x:Name="StartBox" Watermark="2027-01-01 10:00"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
            <TextBlock Text="Окончание (UTC)" Classes="section"/>
            <TextBox x:Name="EndBox" Watermark="2027-01-01 12:00"/>
          </StackPanel>
        </Grid>

        <StackPanel Spacing="4">
          <TextBlock Text="Мест всего" Classes="section"/>
          <TextBox x:Name="SeatsBox" Watermark="10"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#C62828" FontSize="12"
                   TextWrapping="Wrap" IsVisible="False"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Click="Cancel_Click" MinWidth="90" Padding="12,6"/>
      <Button Content="Сохранить" Click="Save_Click" MinWidth="90" Padding="12,6"
              Background="#2196F3" Foreground="White"/>
    </StackPanel>
  </Grid>
</Window>