<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Booking.Desktop.Client.ConfirmDialog"
        Width="420" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#ECEFF1"
        Title="Подтверждение">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="15" FontWeight="Bold"
               Foreground="#263238" Margin="0,0,0,8"/>

    <TextBlock x:Name="MessageText" Grid.Row="1" FontSize="12" Foreground="#455A64"
               TextWrapping="Wrap" VerticalAlignment="Top"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Click="Cancel_Click" MinWidth="90" Padding="12,6"/>
      <Button Content="OK" Click="Ok_Click" MinWidth="90" Padding="12,6"
              Background="#C62828" Foreground="White"/>
    </StackPanel>
  </Grid>
</Window>