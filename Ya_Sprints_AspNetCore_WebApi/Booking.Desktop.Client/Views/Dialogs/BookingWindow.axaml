<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Booking.Desktop.Client.BookingWindow"
          Width="440" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#ECEFF1"
        Title="Создать бронь">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock Grid.Row="0" Text="Создать бронь"
               FontSize="16" FontWeight="Bold" Foreground="#263238" Margin="0,0,0,12"/>

    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock Text="Выберите событие" Classes="section"/>
      <ListBox x:Name="EventsList" Height="180">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="2" Margin="4,6">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Text="{Binding AvailabilityLabel}" FontSize="11" Foreground="#666"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="ErrorText" Foreground="#C62828" FontSize="12"
                 TextWrapping="Wrap" IsVisible="False"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Отмена" Click="Cancel_Click" MinWidth="90" Padding="12,6"/>
      <Button Content="Забронировать" Click="Save_Click" MinWidth="120" Padding="12,6"
              Background="#2196F3" Foreground="White"/>
    </StackPanel>
  </Grid>
</Window>