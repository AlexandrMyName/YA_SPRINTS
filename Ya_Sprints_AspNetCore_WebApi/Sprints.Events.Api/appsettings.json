{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "sprints-events"
  },
  "Jwt": {
    "Mode": "RS256",
    "PrivateKeyPath": "keys/private.pem",
    "PublicKeyPath": "keys/public.pem", 
    "Issuer": "Sprints.Users",
    "Audience": "Sprints.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=events_db;Username=postgres;Password=postgres;SslMode=Disable"
  },
  "AppSettings": {
    "AppName": "MyApp",
    "MaxItems": 10,
    "EnableCache": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
