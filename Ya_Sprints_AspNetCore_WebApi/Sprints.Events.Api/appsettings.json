{
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "sprints-events"
  },
  "Jwt": {
    "Mode": "RS256",
    "PrivateKeyPath": "keys/private.pem",
    "PublicKeyPath": "keys/public.pem",
    "Issuer": "Sprints.Users",
    "Audience": "Sprints.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=events_db;Username=postgres;Password=postgres;SslMode=Disable"
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379,abortConnect=false,connectTimeout=2000,syncTimeout=2000",
    "InstanceName": "sprints:"
  },
  "Cache": {
    "EventTtlSeconds": 300,
    "TopEventsTtlSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}